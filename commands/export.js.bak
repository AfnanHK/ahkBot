const PDFDocument = require('pdfkit');
const ExcelJS = require('exceljs');
const { getMonthlyDetails, getOrCreateUser } = require('../services/financeService');

const BULAN = ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];

function parsePeriod(args) {
    const now = new Date();
    let m = now.getMonth() + 1;
    let y = now.getFullYear();
    const a = (args[0] || '').toLowerCase();

    if (a === 'lalu' || a === 'kemarin') {
        m -= 1;
        if (m === 0) { m = 12; y -= 1; }
    } else if (/^\d{1,2}$/.test(a)) {
        m = parseInt(a, 10);
        if (m < 1 || m > 12) return null;
        if (args[1]) {
            y = parseInt(args[1], 10);
            if (isNaN(y)) return null;
        }
    } else if (a !== '' && a !== 'ini') {
        return null;
    }
    return { m, y };
}

const rp = (n, cur) => (cur === 'USD' ? '$' : 'Rp') + Number(n).toLocaleString('id-ID');
const tgl = (d) => new Date(d).toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' });

function buildPdf(title, rows, categories, totals, cur) {
    return new Promise((resolve, reject) => {
        const doc = new PDFDocument({ margin: 40, size: 'A4' });
        const chunks = [];
        doc.on('data', (c) => chunks.push(c));
        doc.on('end', () => resolve(Buffer.concat(chunks)));
        doc.on('error', reject);

        doc.fontSize(18).text(title, { align: 'center' }).moveDown();
        doc.fontSize(11)
            .text(`Total Pemasukan : ${rp(totals.income, cur)}`)
            .text(`Total Pengeluaran: ${rp(totals.expense, cur)}`)
            .text(`Selisih          : ${rp(totals.income - totals.expense, cur)}`)
            .moveDown();

        if (categories.length) {
            doc.fontSize(13).text('Pengeluaran per Kategori').moveDown(0.3);
            doc.fontSize(10);
            categories.forEach((c) => doc.text(`• ${c.category}: ${rp(c.total, cur)}`));
            doc.moveDown();
        }

        doc.fontSize(13).text('Rincian Transaksi').moveDown(0.3);
        doc.fontSize(9);
        if (!rows.length) doc.text('Tidak ada transaksi.');
        rows.forEach((t) => {
            if (doc.y > 770) doc.addPage();
            const sign = t.type === 'expense' ? '-' : '+';
            doc.text(
                `${tgl(t.created_at)} | ${t.category || '-'} | ${t.description || '-'} | ${sign}${rp(t.amount, cur)}`
            );
        });
        doc.end();
    });
}

async function buildExcel(title, rows, categories, totals, cur) {
    const wb = new ExcelJS.Workbook();
    const ws = wb.addWorksheet('Laporan');
    ws.addRow([title]).font = { bold: true, size: 14 };
    ws.addRow([]);
    ws.addRow(['Total Pemasukan', Number(totals.income)]);
    ws.addRow(['Total Pengeluaran', Number(totals.expense)]);
    ws.addRow(['Selisih', totals.income - totals.expense]);
    ws.addRow([]);
    const head = ws.addRow(['Tanggal', 'Tipe', 'Kategori', 'Deskripsi', `Jumlah (${cur})`]);
    head.font = { bold: true };
    rows.forEach((t) =>
        ws.addRow([tgl(t.created_at), t.type, t.category, t.description, Number(t.amount)])
    );
    ws.columns = [{ width: 18 }, { width: 12 }, { width: 18 }, { width: 30 }, { width: 16 }];

    if (categories.length) {
        const ws2 = wb.addWorksheet('Per Kategori');
        ws2.addRow(['Kategori', 'Total']).font = { bold: true };
        categories.forEach((c) => ws2.addRow([c.category, Number(c.total)]));
        ws2.columns = [{ width: 24 }, { width: 16 }];
    }
    return Buffer.from(await wb.xlsx.writeBuffer());
}

module.exports = {
    name: 'export',
    async execute(ctx) {
        const args = ctx.message.text.split(' ').slice(1);
        const format = (args[0] || '').toLowerCase();

        if (!['pdf', 'excel'].includes(format)) {
            return ctx.reply(
                'Format: /export <excel|pdf> [lalu|bulan] [tahun]\n\n' +
                'Contoh:\n/export pdf\n/export pdf lalu\n/export excel 8 2026'
            );
        }

        const period = parsePeriod(args.slice(1));
        if (!period) {
            return ctx.reply('❌ Bulan tidak valid. Contoh: /export pdf lalu atau /export pdf 8 2026');
        }

        try {
            const user = await getOrCreateUser(ctx.from.id);
            const cur = user.currency || 'IDR';
            const data = await getMonthlyDetails(ctx.from.id, period.m, period.y);
            const rows = data.transactions;

            const totals = rows.reduce(
                (a, t) => {
                    const v = parseFloat(t.amount);
                    if (t.type === 'expense') a.expense += v; else a.income += v;
                    return a;
                },
                { income: 0, expense: 0 }
            );

            const title = `Laporan Keuangan ${BULAN[period.m - 1]} ${period.y}`;
            const base = `laporan-${period.y}-${String(period.m).padStart(2, '0')}`;

            await ctx.reply('⏳ Menyiapkan laporan...');

            if (format === 'pdf') {
                const buf = await buildPdf(title, rows, data.categories, totals, cur);
                await ctx.replyWithDocument({ source: buf, filename: `${base}.pdf` });
            } else {
                const buf = await buildExcel(title, rows, data.categories, totals, cur);
                await ctx.replyWithDocument({ source: buf, filename: `${base}.xlsx` });
            }
        } catch (err) {
            console.error('[EXPORT ERROR]', err);
            await ctx.reply('❌ Gagal membuat laporan: ' + err.message);
        }
    }
};
